# Neon PostgreSQL (pooled connection) - nunca commitar valores reais
DATABASE_URL=
# Vercel Blob (opcional)
BLOB_READ_WRITE_TOKEN=
# Segredo de autenticação (gerar com: openssl rand -base64 32)
AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Somente dígitos com DDI, ex.: 55DDDNUMERO
NEXT_PUBLIC_WHATSAPP=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# ADMIN1 é obrigatório; ADMIN2 é opcional (script npm run admins:create). Senhas com 12+ caracteres. Nunca commitar.
ADMIN1_EMAIL=
ADMIN1_NAME=
ADMIN1_PASSWORD=
ADMIN2_EMAIL=
ADMIN2_NAME=
ADMIN2_PASSWORD=
